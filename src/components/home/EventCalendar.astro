---

---

<article class="event-calendar">
	<div class="calendar__main">
		<div class="calendar__header">
			<button class="calendar__btn" id="prev-month">&larr;</button>
			<h3 class="calendar__title" id="month-year">October 2026</h3>
			<button class="calendar__btn" id="next-month">&rarr;</button>
		</div>
		<div class="calendar__grid-header">
			<span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span
				>Fr</span
			><span>Sa</span>
		</div>
		<div class="calendar__grid" id="calendar-days">
			<!-- Days injected by JS -->
		</div>
	</div>
	<div class="calendar__sidebar">
		<h4 class="sidebar__title">Selected Event</h4>
		<div id="event-details" class="sidebar__details">
			<p class="sidebar__empty">Select a highlighted date to see event details.</p>
		</div>
	</div>
</article>

<style is:global>
	.event-calendar {
		background: color-mix(in srgb, var(--cream) 34%, #fff);
		border: 1px solid rgba(44, 39, 33, 0.09);
		border-radius: 10px;
		display: grid;
		grid-template-columns: 2fr 1fr;
		box-shadow: 0 2px 5px rgba(44, 39, 33, 0.06);
		height: 100%;
		overflow: hidden;
	}

	.calendar__main {
		padding: clamp(1.5rem, 3vw, 2rem);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.calendar__header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.calendar__title {
		font-family: var(--face-bodoni);
		font-size: 1.5rem;
		color: var(--teal);
		margin: 0;
	}

	.calendar__btn {
		background: transparent;
		border: 1px solid color-mix(in srgb, var(--teal) 30%, transparent);
		color: var(--teal);
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		cursor: pointer;
		display: grid;
		place-items: center;
		transition: all 200ms ease;
	}

	.calendar__btn:hover {
		background: color-mix(in srgb, var(--teal) 10%, transparent);
	}

	.calendar__grid-header {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		text-align: center;
		font-weight: 600;
		color: var(--ink-soft);
		font-size: 0.85rem;
		margin-bottom: -0.5rem;
	}

	.calendar__grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 0.5rem;
		text-align: center;
	}

	.calendar__day {
		aspect-ratio: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		cursor: pointer;
		font-size: 0.95rem;
		color: var(--ink);
		transition: all 200ms ease;
		position: relative;
	}

	.calendar__day:hover {
		background: color-mix(in srgb, var(--teal) 10%, transparent);
	}

	.calendar__day--muted {
		color: color-mix(in srgb, var(--ink) 30%, transparent);
	}

	.calendar__day--has-event::after {
		content: '';
		display: block;
		width: 6px;
		height: 6px;
		background: var(--rose);
		border-radius: 50%;
		margin-top: 2px;
	}

	.calendar__day--selected {
		background: var(--teal) !important;
		color: #fff !important;
	}

	.calendar__sidebar {
		background: color-mix(in srgb, var(--teal) 8%, transparent);
		padding: clamp(1.5rem, 3vw, 2rem);
		border-left: 1px solid rgba(44, 39, 33, 0.09);
	}

	.sidebar__title {
		font-family: var(--face-bodoni);
		font-size: 1.25rem;
		color: var(--teal-deep);
		margin: 0 0 1.5rem 0;
	}

	.sidebar__details {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.sidebar__empty {
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.event-card {
		background: #fff;
		border: 1px solid rgba(44, 39, 33, 0.09);
		border-radius: 8px;
		padding: 1rem;
		box-shadow: 0 2px 4px rgba(44, 39, 33, 0.04);
	}

	.event-card__time {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sage);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.25rem;
		display: block;
	}

	.event-card__title {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--ink);
		margin: 0 0 0.5rem 0;
	}

	.event-card__desc {
		font-size: 0.85rem;
		color: var(--ink-soft);
		margin: 0;
		line-height: 1.4;
	}

	@media (max-width: 768px) {
		.event-calendar {
			grid-template-columns: 1fr;
		}
		.calendar__sidebar {
			border-left: none;
			border-top: 1px solid rgba(44, 39, 33, 0.09);
		}
	}
</style>

<script>
	const events = [
		{
			date: '2026-10-05',
			title: 'Monthly Volunteer Sync (Zoom)',
			time: '11:00 AM',
			desc: 'A quick online catch-up with our volunteers globally.',
		},
		{
			date: '2026-10-10',
			title: 'Pune Milk Bag Project Meet',
			time: '4:00 PM',
			desc: 'Offline event at Pune collection center for recycling.',
		},
		{
			date: '2026-10-15',
			title: 'Cancer Care Meetup',
			time: '10:00 AM',
			desc: 'Support and discussion group for individuals and families.',
		},
		{
			date: '2026-10-18',
			title: 'Periods ki Pathshala Webinar',
			time: '12:30 PM',
			desc: 'Online Zoom webinar raising awareness about menstrual health.',
		},
		{
			date: '2026-10-22',
			title: 'Neurodivergence Workshop',
			time: '2:00 PM',
			desc: 'An interactive offline workshop embracing cognitive diversity.',
		},
		{
			date: '2026-10-28',
			title: 'Rainwater Harvesting Visit',
			time: '9:00 AM',
			desc: 'Offline tour of the newly implemented community tanks.',
		},
		{
			date: '2026-11-05',
			title: 'Conservation Drive',
			time: '9:00 AM',
			desc: 'Tree planting and local environmental cleanup.',
		},
	];

	let currentDate = new Date(2026, 9, 1); // Oct 2026

	const monthYearEl = document.getElementById('month-year');
	const daysEl = document.getElementById('calendar-days');
	const detailsEl = document.getElementById('event-details');
	const prevBtn = document.getElementById('prev-month');
	const nextBtn = document.getElementById('next-month');

	function renderCalendar() {
		daysEl.innerHTML = '';
		const year = currentDate.getFullYear();
		const month = currentDate.getMonth();

		const firstDay = new Date(year, month, 1).getDay();
		const daysInMonth = new Date(year, month + 1, 0).getDate();

		monthYearEl.innerText = currentDate.toLocaleString('default', {
			month: 'long',
			year: 'numeric',
		});

		// Pad empty days
		for (let i = 0; i < firstDay; i++) {
			const empty = document.createElement('div');
			daysEl.appendChild(empty);
		}

		// Days
		for (let i = 1; i <= daysInMonth; i++) {
			const dayBtn = document.createElement('div');
			dayBtn.className = 'calendar__day';
			dayBtn.innerText = i;

			const dateString =
				year +
				'-' +
				String(month + 1).padStart(2, '0') +
				'-' +
				String(i).padStart(2, '0');
			const dayEvents = events.filter((e) => e.date === dateString);

			if (dayEvents.length > 0) {
				dayBtn.classList.add('calendar__day--has-event');
			}

			dayBtn.onclick = () => {
				document
					.querySelectorAll('.calendar__day')
					.forEach((d) => d.classList.remove('calendar__day--selected'));
				dayBtn.classList.add('calendar__day--selected');
				showEvents(dayEvents);
			};

			daysEl.appendChild(dayBtn);
		}
	}

	function showEvents(dayEvents) {
		if (dayEvents.length === 0) {
			detailsEl.innerHTML =
				'<p class="sidebar__empty">No events scheduled for this day.</p>';
			return;
		}

		detailsEl.innerHTML = dayEvents
			.map(
				(e) =>
					'<div class="event-card"><span class="event-card__time">' +
					e.time +
					'</span><h5 class="event-card__title">' +
					e.title +
					'</h5><p class="event-card__desc">' +
					e.desc +
					'</p></div>',
			)
			.join('');
	}

	if (prevBtn)
		prevBtn.onclick = () => {
			currentDate.setMonth(currentDate.getMonth() - 1);
			renderCalendar();
		};
	if (nextBtn)
		nextBtn.onclick = () => {
			currentDate.setMonth(currentDate.getMonth() + 1);
			renderCalendar();
		};

	if (daysEl) renderCalendar();
</script>
