---

<article class="trivia-game">
	<div class="trivia__header">
		<h3 class="trivia__title">Did You Know?</h3>
		<span class="trivia__score">Score: <span id="trivia-score">0</span></span>
	</div>
	<div class="trivia__body" id="trivia-body">
		<p class="trivia__question" id="trivia-question">Loading question...</p>
		<div class="trivia__options" id="trivia-options"></div>
	</div>
	<div class="trivia__feedback" id="trivia-feedback" hidden>
		<p id="trivia-feedback-text"></p>
		<button class="trivia__next" id="trivia-next">Next Question &rarr;</button>
	</div>
</article>

<style>
	.trivia-game {
		background: color-mix(in srgb, var(--cream) 34%, #fff);
		border: 1px solid rgba(44, 39, 33, 0.09);
		border-radius: 10px;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		box-shadow: 0 2px 5px rgba(44, 39, 33, 0.06);
		height: 100%;
		justify-content: center;
	}

	.trivia__header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid rgba(44, 39, 33, 0.1);
		padding-bottom: 1rem;
	}

	.trivia__title {
		font-family: var(--face-bodoni);
		font-size: clamp(1.5rem, 2.5vw, 2.2rem);
		color: var(--teal);
		margin: 0;
	}

	.trivia__score {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--ink-soft);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.trivia__question {
		font-size: 1.15rem;
		color: var(--ink);
		line-height: 1.5;
		margin: 0 0 1.5rem 0;
	}

	.trivia__options {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.trivia__option {
		background: transparent;
		border: 1px solid color-mix(in srgb, var(--teal) 30%, transparent);
		padding: 0.8rem 1.2rem;
		border-radius: 6px;
		color: var(--teal-deep);
		font-size: 0.95rem;
		cursor: pointer;
		text-align: left;
		transition: all 200ms ease;
	}

	.trivia__option:hover:not(:disabled) {
		background: color-mix(in srgb, var(--teal) 10%, transparent);
		border-color: var(--teal);
	}

	.trivia__option.correct {
		background: var(--sage);
		border-color: var(--sage);
		color: #fff;
	}

	.trivia__option.wrong {
		background: var(--rose);
		border-color: var(--rose);
		color: #fff;
	}

	.trivia__feedback {
		background: color-mix(in srgb, var(--cream) 80%, #fff);
		padding: 1.5rem;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		animation: slideUp 300ms ease-out;
		margin-top: 1rem;
	}

	.trivia__feedback p {
		margin: 0;
		font-weight: 500;
		color: var(--ink);
	}

	.trivia__next {
		background: var(--teal);
		color: #fff;
		border: none;
		padding: 0.6rem 1.2rem;
		border-radius: 99px;
		cursor: pointer;
		font-weight: 600;
		transition: transform 200ms ease;
	}

	.trivia__next:hover {
		transform: scale(1.05);
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		.trivia__options {
			grid-template-columns: 1fr;
		}
		.trivia__feedback {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
	}
</style>

<script>
	const questions = [
		{
			q: 'Which of these is considered a form of neurodivergence?',
			options: ['Autism', 'Dyslexia', 'ADHD', 'All of the above'],
			answer: 3,
			fact: 'Neurodivergence embraces the diverse ways human brains function and process information.',
		},
		{
			q: 'What is a key focus of environmental conservation?',
			options: [
				'Increasing plastic',
				'Protecting nature',
				'Urban sprawl',
				'Deforestation',
			],
			answer: 1,
			fact: 'Conservation involves sustainable use of nature by humans, protecting land, air, and water.',
		},
		{
			q: 'What is the primary goal of Cancer Care initiatives?',
			options: [
				'Isolating patients',
				'Providing support',
				'Ignoring symptoms',
				'Only funding',
			],
			answer: 1,
			fact: 'Our Cancer Care pillar focuses on providing care, courage, and hope to individuals.',
		},
	];

	let currentQ = 0;
	let score = 0;

	const questionEl = document.getElementById('trivia-question');
	const optionsEl = document.getElementById('trivia-options');
	const feedbackEl = document.getElementById('trivia-feedback');
	const feedbackTextEl = document.getElementById('trivia-feedback-text');
	const nextBtn = document.getElementById('trivia-next');
	const scoreEl = document.getElementById('trivia-score');

	function loadQuestion() {
		if (currentQ >= questions.length) {
			questionEl.innerText =
				"Thanks for playing! You've completed the trivia. Restarting in 6 seconds...";
			optionsEl.innerHTML = '';
			feedbackEl.hidden = true;

			setTimeout(() => {
				currentQ = 0;
				score = 0;
				scoreEl.innerText = score;
				loadQuestion();
			}, 6000);

			return;
		}

		const q = questions[currentQ];
		questionEl.innerText = q.q;
		optionsEl.innerHTML = '';
		feedbackEl.hidden = true;

		q.options.forEach((opt, index) => {
			const btn = document.createElement('button');
			btn.className = 'trivia__option';
			btn.innerText = opt;
			btn.onclick = () => selectOption(btn, index, q.answer, q.fact);
			optionsEl.appendChild(btn);
		});
	}

	function selectOption(btn, selected, correct, fact) {
		const allBtns = optionsEl.querySelectorAll('button');
		allBtns.forEach((b) => (b.disabled = true));

		if (selected === correct) {
			btn.classList.add('correct');
			score++;
			scoreEl.innerText = score;
			feedbackTextEl.innerHTML = '<strong>Correct!</strong> ' + fact;
		} else {
			btn.classList.add('wrong');
			allBtns[correct].classList.add('correct');
			feedbackTextEl.innerHTML = '<strong>Incorrect.</strong> ' + fact;
		}

		feedbackEl.hidden = false;
	}

	if (nextBtn) {
		nextBtn.onclick = () => {
			currentQ++;
			loadQuestion();
		};
	}

	if (questionEl) loadQuestion();
</script>
